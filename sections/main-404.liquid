<div class="template-404 page-width page-width--narrow section-{{ section.id }}-padding">
  <div class="template-404__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="template-404__heading h1">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="template-404__title h2">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="template-404__text rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_search -%}
      <div class="template-404__search">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
          <div class="field">
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.search' | t }}"
              class="field__input"
              aria-label="{{ 'general.search.search' | t }}"
            >
            <label class="field__label" for="Search-404">{{ 'general.search.search' | t }}</label>
          </div>
          <button type="submit" class="button button--primary">
            {{ 'general.search.submit' | t }}
          </button>
        </form>
      </div>
    {%- endif -%}

    {%- if section.settings.show_back_link -%}
      <div class="template-404__links">
        <a href="{{ routes.root_url }}" class="button button--secondary">
          {{ 'general.404.link' | t }}
        </a>
        <button type="button" class="button button--tertiary" onclick="window.history.back();">
          {{ 'general.404.back' | t }}
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .template-404 {
    text-align: center;
  }

  .template-404__content {
    max-width: 60rem;
    margin: 0 auto;
  }

  .template-404__heading {
    font-size: 8rem;
    line-height: 1;
    margin-bottom: 2rem;
    color: var(--color-primary, #1a365d);
  }

  .template-404__title {
    margin-bottom: 1.5rem;
  }

  .template-404__text {
    margin-bottom: 3rem;
    font-size: 1.6rem;
  }

  .template-404__search {
    margin-bottom: 3rem;
  }

  .template-404__search .search-form {
    display: flex;
    gap: 1rem;
    max-width: 50rem;
    margin: 0 auto;
  }

  .template-404__search .field {
    flex: 1;
  }

  .template-404__search .field__input {
    width: 100%;
    padding: 1.2rem 1.6rem;
    border: 1px solid rgba(var(--color-base-text), 0.2);
    border-radius: var(--buttons-radius, 8px);
  }

  .template-404__links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media screen and (max-width: 749px) {
    .template-404__heading {
      font-size: 6rem;
    }

    .template-404__search .search-form {
      flex-direction: column;
    }

    .template-404__links {
      flex-direction: column;
      align-items: stretch;
    }

    .template-404__links .button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "404"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Page not found"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The page you were looking for does not exist.</p><p>Maybe you want to try the search instead?</p>"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search form"
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "default": true,
      "label": "Show back link"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ]
}
{% endschema %}

