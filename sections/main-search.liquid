{%- if search.performed -%}
  <div class="template-search page-width section-{{ section.id }}-padding">
    <div class="template-search__header">
      <h1 class="h2">
        {%- if search.results_count > 0 -%}
          {{ 'templates.search.title' | t }}
        {%- else -%}
          {{ 'templates.search.no_results' | t }}
        {%- endif -%}
      </h1>
      <p class="template-search__term">
        {{ 'templates.search.results_for' | t: terms: search.terms | escape }}
      </p>
    </div>

    {%- if search.results_count > 0 -%}
      <div class="template-search__results">
        <div class="grid grid--2-col grid--3-col-tablet grid--4-col-desktop">
          {%- for item in search.results -%}
            <div class="grid__item">
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item, show_quick_add: section.settings.enable_quick_add %}
                {%- when 'article' -%}
                  <div class="card-wrapper">
                    <div class="card card--media">
                      {%- if item.image -%}
                        <div class="card__media">
                          <a href="{{ item.url }}" class="media media--{{ section.settings.image_ratio }}">
                            {{ item.image | image_url: width: 533 | image_tag: loading: 'lazy', alt: item.image.alt | escape }}
                          </a>
                        </div>
                      {%- endif -%}
                      <div class="card__content">
                        <h3 class="card__heading h5">
                          <a href="{{ item.url }}">{{ item.title | escape }}</a>
                        </h3>
                        {%- if section.settings.show_excerpt and item.excerpt != blank -%}
                          <p class="card__excerpt">{{ item.excerpt | strip_html | truncatewords: 15 }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- when 'page' -%}
                  <div class="card-wrapper">
                    <div class="card">
                      <div class="card__content">
                        <h3 class="card__heading h5">
                          <a href="{{ item.url }}">{{ item.title | escape }}</a>
                        </h3>
                        {%- if section.settings.show_excerpt and item.content != blank -%}
                          <p class="card__excerpt">{{ item.content | strip_html | truncatewords: 15 }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="template-search__empty">
        <p>{{ 'templates.search.no_results_text' | t: terms: search.terms | escape }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
{%- else -%}
  <div class="template-search page-width section-{{ section.id }}-padding">
    <div class="template-search__header">
      <h1 class="h2">{{ 'general.search.search' | t }}</h1>
    </div>
    <div class="template-search__form">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.search' | t }}"
          class="input__field"
        >
        <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Results per page"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "default": true,
      "label": "Show excerpt"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": false,
      "label": "Enable quick add for products"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}

