<div class="page-width section-{{ section.id }}-padding">
  {%- if section.settings.title != blank -%}
    <h1 class="main-collections-title h1">{{ section.settings.title | escape }}</h1>
  {%- endif -%}

  <div class="grid grid--2-col grid--3-col-tablet grid--4-col-desktop">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <div class="grid__item">
          <div class="card-wrapper">
            <div class="card card--media">
              {%- if collection.featured_image -%}
                <div class="card__media">
                  <a href="{{ collection.url }}" class="media media--{{ section.settings.image_ratio }}">
                    {{ collection.featured_image | image_url: width: 533 | image_tag: loading: 'lazy', alt: collection.featured_image.alt | escape }}
                  </a>
                </div>
              {%- endif -%}
              <div class="card__content">
                <h3 class="card__heading h5">
                  <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
                </h3>
                {%- if section.settings.show_description and collection.description != blank -%}
                  <p class="card__excerpt">{{ collection.description | strip_html | truncatewords: 15 }}</p>
                {%- endif -%}
                <p class="card__info">
                  {{ 'sections.collection_list.products_count' | t: count: collection.products_count }}
                </p>
              </div>
            </div>
          </div>
        </div>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns (desktop)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "Show description"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}

