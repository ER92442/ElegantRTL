{%- assign share_url = shop.url | append: product.url -%}
{%- assign share_title = product.title | url_param_escape -%}
{%- assign share_permalink = request.origin | append: product.url -%}

<div class="social-share">
  <span class="social-share__label">{{ 'general.social.share_label' | t }}:</span>
  <ul class="social-share__list list-unstyled" role="list">
    <li class="social-share__item">
      <a href="//www.facebook.com/sharer.php?u={{ share_permalink }}" class="social-share__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.share_on_facebook' | t }}">
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-facebook" viewBox="0 0 18 18">
          <path fill="currentColor" d="M16.42.59c-1.8-.7-3.75-1.1-5.83-1.1C6.4-.5 2.73 3.18 2.73 7.5c0 .45.04.9.1 1.34L0 16.5h4.5v-5.25c0-.6.45-1.1 1-1.1h2.5V7.5H5.5V5.75c0-1.38 1.12-2.5 2.5-2.5h2.5V1.5h-2.5c-2.76 0-5 2.24-5 5v1.5H1v2.25h1.5v5.25H6v5.25h2.5v-5.25h2.5l.5-2.25H8.5v-1.5c0-.55.45-1 1-1h2.5V7.5H9.5c-.55 0-1 .45-1 1v1.5H7v2.25h1.5v5.25H11v-5.25h2.5l.5-2.25H11v-1.5c0-1.38 1.12-2.5 2.5-2.5h2.5V7.5h-2.5c-.55 0-1 .45-1 1v1.5h-1.5v2.25H13l.5-2.25h-1.5v-1.5c0-.55.45-1 1-1h2.5V7.5h-2.5c-1.38 0-2.5 1.12-2.5 2.5v1.5H9v2.25h1.5v5.25H13v-5.25h2.5l.5-2.25H13v-1.5c0-1.38 1.12-2.5 2.5-2.5h2.5V7.5h-2.5c-1.38 0-2.5 1.12-2.5 2.5v1.5h-1.5v2.25H14l.5-2.25h-1.5v-1.5c0-1.38 1.12-2.5 2.5-2.5h2.5V7.5h-2.5c-1.38 0-2.5 1.12-2.5 2.5v1.5H11v2.25h1.5v5.25H15v-5.25h2.5l.5-2.25H15v-1.5c0-1.38 1.12-2.5 2.5-2.5h2.5V7.5h-2.5c-1.38 0-2.5 1.12-2.5 2.5v1.5h-1.5v2.25H16l.5-2.25h-1.5v-1.5c0-1.38 1.12-2.5 2.5-2.5h2.5V7.5h-2.5c-1.38 0-2.5 1.12-2.5 2.5v1.5H13v2.25h1.5v5.25H17v-5.25h1.42c.7-1.8 1.1-3.75 1.1-5.83 0-4.32-3.68-8-8-8z"/>
        </svg>
        <span class="visually-hidden">{{ 'general.social.share_on_facebook' | t }}</span>
      </a>
    </li>
    <li class="social-share__item">
      <a href="//twitter.com/share?text={{ share_title }}&amp;url={{ share_permalink }}" class="social-share__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.share_on_twitter' | t }}">
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-twitter" viewBox="0 0 18 15">
          <path fill="currentColor" d="M17.64 2.6a7.33 7.33 0 01-1.75 1.82c0 .05 0 .13.02.19l.02.19c.15 1.16.04 2.32-.33 3.38a10.48 10.48 0 01-1.65 3.07 12.58 12.58 0 01-2.68 2.72c-1.19.9-2.64 1.47-4.1 1.66-1.46.2-2.93.05-4.33-.43a9.9 9.9 0 01-3.33-1.84l-.32-.3.09-.42c.06-.29.1-.6.1-.92 0-1.3.5-2.5 1.4-3.4a4.8 4.8 0 013.4-1.4c.95 0 1.8.27 2.5.82a4.65 4.65 0 001.5-.57 4.55 4.55 0 01-1.44-1.5c.52.1 1.05.16 1.58.1a4.56 4.56 0 01-1.98-1.23 4.52 4.52 0 01-1.1-2.97c0-.54.15-1.08.4-1.54a12.9 12.9 0 004.3 1.12 4.52 4.52 0 011.1-2.97c.6-.6 1.4-.94 2.26-.94.85 0 1.66.34 2.26.94.6-.12 1.17-.34 1.7-.65a4.56 4.56 0 01-2 2.5c.73-.08 1.46-.28 2.13-.57a9.9 9.9 0 01-2.35 2.33z"/>
        </svg>
        <span class="visually-hidden">{{ 'general.social.share_on_twitter' | t }}</span>
      </a>
    </li>
    <li class="social-share__item">
      <a href="//pinterest.com/pin/create/button/?url={{ share_permalink }}&amp;media={{ product.featured_media | image_url: width: 1024, height: 1024 }}&amp;description={{ share_title }}" class="social-share__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.share_on_pinterest' | t }}">
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-pinterest" viewBox="0 0 17 18">
          <path fill="currentColor" d="M8.48.58a8.42 8.42 0 016.15 2.45 8.42 8.42 0 011.9 11.24 8.28 8.28 0 01-7.23 4.16 8.5 8.5 0 01-2.23-.3c.42-.68.7-1.29.85-1.8l.59-2.29c.16.3.41.55.73.75.28.18.6.28.94.28a2.75 2.75 0 002.75-2.75c0-1.14-.92-2.27-2.27-2.27a2.5 2.5 0 00-2.5 2.5c0 .5.16.96.44 1.34.1.12.12.23.08.36l-.2.8c-.05.2-.2.25-.4.15-1.1-.5-1.8-2.1-1.8-3.4 0-2.78 2.24-5.3 5.3-5.3 2.78 0 4.95 1.98 4.95 4.6 0 2.78-1.75 5.13-4.28 5.13-.84 0-1.63-.44-1.9-1.02l-.5 1.9c-.18.7-.7 1.58-1.05 2.1a8.23 8.23 0 01-5.3 1.8 8.42 8.42 0 01-1.9-16.45A8.5 8.5 0 018.48.58zm.28 1.9a6.52 6.52 0 00-6.5 6.5c0 2.4 1.4 4.5 3.4 5.5.25-.7 1-3.1 1.4-4.1.1-.4.05-.7-.2-1-.3-.4-.5-1-.5-1.6 0-2.2 1.7-4.2 4.2-4.2 2.3 0 4.1 1.7 4.1 4 0 2.5-1.5 4.6-3.7 4.6-.7 0-1.4-.4-1.6-.9 0 0-.4 1.6-.5 1.9-.2.7-.6 1.4-1 2a6.44 6.44 0 003.9 1.3c3.6 0 6.5-2.9 6.5-6.5C15.26 5.2 12.36 2.48 8.76 2.48z"/>
        </svg>
        <span class="visually-hidden">{{ 'general.social.share_on_pinterest' | t }}</span>
      </a>
    </li>
  </ul>
</div>

