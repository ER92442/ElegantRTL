{%- if paginate.pages > 1 -%}
  <nav class="pagination-wrapper" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination list-unstyled" role="list">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}" class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce" aria-label="{{ 'general.pagination.previous' | t }}">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" viewBox="0 0 10 6">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
            </svg>
          </a>
        </li>
      {%- else -%}
        <li>
          <span class="pagination__item pagination__item--prev pagination__item--disabled" aria-label="{{ 'general.pagination.previous' | t }}" aria-disabled="true">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" viewBox="0 0 10 6">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
            </svg>
          </span>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <li>
            <a href="{{ part.url }}" class="pagination__item link" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          </li>
        {%- else -%}
          {%- if part.title == paginate.current_page -%}
            <li>
              <span class="pagination__item pagination__item--current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
            </li>
          {%- else -%}
            <li>
              <span class="pagination__item">{{ part.title }}</span>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}" class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce" aria-label="{{ 'general.pagination.next' | t }}">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" viewBox="0 0 10 6">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M.646 5.354a.5.5 0 000 .708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 00-.708-.708L5 9.293 1.354 5.646a.5.5 0 00-.708 0z" fill="currentColor"/>
            </svg>
          </a>
        </li>
      {%- else -%}
        <li>
          <span class="pagination__item pagination__item--next pagination__item--disabled" aria-label="{{ 'general.pagination.next' | t }}" aria-disabled="true">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" viewBox="0 0 10 6">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M.646 5.354a.5.5 0 000 .708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 00-.708-.708L5 9.293 1.354 5.646a.5.5 0 00-.708 0z" fill="currentColor"/>
            </svg>
          </span>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}

